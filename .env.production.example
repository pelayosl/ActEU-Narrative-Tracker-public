# Production environment template for the ActEU Narrative Tracker.
# Copy to `.env` on the deployment host and fill in real values.
# NEVER commit the filled-in .env (it is gitignored).

# --- Auth / secrets (ROTATE — do not reuse dev values) ------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Bootstrap admin account -------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_SURNAME=User
ADMIN_PROJECT_NAME=Default Project

# --- MongoDB (authentication enabled in production) --------------------
MONGO_ROOT_USERNAME=acteu_admin
MONGO_ROOT_PASSWORD=
MONGODB_DB=acteu

# --- Frontend / NextAuth -----------------------------------------------
# Public HTTPS URL of the deployment (the VPN IP behind nginx).
NEXTAUTH_URL=https://156.35.163.169

# --- Dataset import location (host path, mounted read-only) ------------
DATA_DIR=/srv/acteu/dataset

# --- University LLM + embeddings ---------------------------------------
OLLAMA_URL=http://156.35.160.78:4000/v1/chat/completions
LLM_API_KEY=
HF_TOKEN=
