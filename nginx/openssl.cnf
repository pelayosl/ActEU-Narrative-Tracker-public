# OpenSSL config for the ActEU internal server certificate.
# The subjectAltName MUST carry the IP — modern browsers ignore the CN and
# validate the connection IP against the SAN.

[req]
default_bits        = 2048
prompt              = no
default_md          = sha256
distinguished_name  = dn
req_extensions      = v3_req

[dn]
C  = ES
O  = ActEU Narrative Tracker
CN = 156.35.163.169

[v3_req]
basicConstraints     = CA:FALSE
keyUsage             = digitalSignature, keyEncipherment
extendedKeyUsage     = serverAuth
subjectAltName       = @alt_names

[alt_names]
IP.1 = 156.35.163.169
