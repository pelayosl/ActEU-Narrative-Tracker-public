@startuml
title Data Ingestion — Raw ActEU sources -> Normalised NDJSON -> MongoDB

start

partition "0. Language pre-filtering (optional)\n[data_processing.py]" {
  :Raw multi-language source NDJSON;
  :Keep lines where language\nOR language_detected == target code;
  :Per-language NDJSON\n(filtered-docs/<platform>/<lang>);
  note right
    Optional — only needed when the upstream
    data arrives as one mixed-language file.
  end note
}

partition "1. Transformation (per platform)\n[ingest_news / ingest_telegram / ingest_tweets + ingestion.py]" {
  :Select platform adapter\n(news / telegram / tweets);

  while (more lines in source NDJSON?) is (yes)
    :Read next line;
    if (valid JSON?) then (no)
      :Count + skip line (warn);
    else (yes)
      :transform_<platform>(raw);
      if (plain_text empty?) then (yes)
        :Skip document (missing critical field);
      else (no)
        :Map raw -> DB document;
        :Platform-specific fields\n(headline, plain_text, author, platform);
        :country <- LANGUAGE_TO_COUNTRY[language];
        :acteu_topic <- extract_acteu_topic\n(PresumedIssue -> core slug, max confidence);
        :subtopics <- extract_acteu_subtopic\n(FirstSubtopic, skip N/A,\ntopic_id = uuid5(namespace, label));
        :sentiment <- extract_sentiment\n(GeneralTone, 0.20 margin tie-break else None);
        :named_entities <- extract_named_entities\n(wikidata_entities, drop URLs, dedup by label);
        :Append normalised document to output NDJSON;
      endif
    endif
  endwhile (no)

  :Normalised NDJSON in DB schema\n(db/<platform>/<platform>-<lang>-db.ndjson);
  note right
    Shared core (ingestion.py) holds all annotation
    interpretation; adapters only map raw field names.
    Output shape == documents collection schema.
  end note
}

partition "2. Load into MongoDB\n[load_mongodb.py]" {
  :Drop target database\n(clean, reproducible rebuild);

  while (more platform dirs: tweets / telegram / news?) is (yes)
    while (more lines in NDJSON?) is (yes)
      :Ensure subtopics field exists;
      :published_time -> BSON Date\n(parse_published_time);
      :Add to batch;
      if (batch >= 500?) then (yes)
        :insert_many(ordered=False) into documents;
      endif
    endwhile (no)
    :Flush remaining batch;
  endwhile (no)

  :Seed 3 core topics\n(core_topic = slug);
  :Seed db-subtopic catalogue\n($unwind + $group by topic_id, upsert,\ncore_topic = null — idempotent);
  :Seed admin user (bcrypt) + starter project;
  :Create indexes\n(documents, topics, users, projects);
  note right
    Subtopic topic_ids are the deterministic uuid5
    values from stage 1, so the catalogue upsert
    never duplicates across loads/batches.
  end note
}

partition "3. Corrective migration (one-off)\n[migrate_published_time.py]" {
  if (any documents.published_time of $type string?) then (yes)
    :Parse legacy / locale-formatted strings\n(e.g. "dom, 01 oct 2023 ... +0200");
    :bulk_write $set -> BSON Date;
    note right
      Idempotent: only string-typed values are touched.
      MongoDB datetime range filters never match strings,
      which silently emptied date-filtered queries.
    end note
  else (no)
    :Nothing to migrate;
  endif
}

:MongoDB ready\n(documents + topics + users + projects);
stop

@enduml
