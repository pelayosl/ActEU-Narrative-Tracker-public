@startuml
title Pipeline Orchestration — Search -> Topic Modelling -> Label Dataset

start

:Enter Pipeline;
:Select or create a project;

note right
  **Session resumption** — hydrateFromProject reads project.pending_pipeline
  and re-enters at the matching step:
  - none                              -> Search
  - generated_topics only             -> Topic Modelling (edit, 2b)
  - reconciled_topics present         -> Topic Modelling (reconciled, 2c)
  - classifier_id stamped & resolvable -> Label Dataset
end note

partition "1. Search" {
  repeat
    :Enter SearchQuery\n(keywords, dates, languages, platforms,\ntopics, subtopics, confidence_threshold);
    :Run faceted search (synchronous);
  repeat while (0 documents?) is (yes) not (no)
  :Hold SearchResult + SearchQuery in PipelineStore;
}

partition "2. Topic Modelling" {
  :Generate topics — BERTopic + LLM labelling\n[async Celery job];
  note right
    set_pending_pipeline:
    generated_topics + topic_mapping
    (overwrites any previous pending_pipeline)
  end note

  if (any topics generated?) then (no)
    :Notify "no topics" — return to Search to broaden the query;
    stop
  else (yes)
  endif

  repeat
    :Edit / merge / delete topics\n(frontend only, in PipelineStore);
    if (Reconcile topics?) then (yes)
      :Reconcile via LLMClient\n[async Celery job];
      note right
        update_reconciled_topics:
        only pending_pipeline.reconciled_topics
        (generated_topics + topic_mapping kept)
      end note
      :Edit reconciled topics\n(split / edit, frontend only);
      if (Accept reconciled list?) then (yes)
        :ready to proceed;
      else (cancel)
        :Discard reconciliation,\nrestore generated_topics;
        :back to editing;
      endif
    else (skip to labelling)
      :ready to proceed;
    endif
  repeat while (ready to proceed?) is (no) not (yes)
}

partition "3. Label Dataset" {
  :Select topics (>= 1) + classifier name;
  :Train FastText classifier\n[async Celery job];
  note right
    save_classifier + stamp_pipeline_classifier.
    pending_pipeline is NOT cleared —
    topic_mapping kept for Phase 1.
  end note

  if (Phase 1 — pending_pipeline still\nbelongs to this classifier?) then (yes)
    :Phase 1 — label retrieved documents\n(synchronous, ProjectService);
    :Write proxies (confidence = 1);
    :clear_pending_pipeline;
  else (overwritten by a newer run)
    :Phase 1 unavailable\n(PendingPipelineMismatch);
    note right: A newer generation run overwrote the\npipeline before Phase 1 — use Phase 2 instead.
  endif

  while (Label another custom query? (Phase 2)) is (yes)
    :Phase 2 — label custom query\n[async Celery job, per-project Redis mutex];
    :Write predicted proxies (confidence = score)\n(skip already-labelled & "Other");
  endwhile (no)
}

:Go to Visualiser\n(carry SearchQuery forward as prefill);
stop

@enduml
