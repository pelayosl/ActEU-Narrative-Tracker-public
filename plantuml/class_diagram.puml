@startuml ActEU_Narrative_Tracker_Backend
' =====================================================================
'  ActEU Narrative Tracker — Backend Class Diagram
'  Layered architecture: API (Routers) -> Services -> Repositories
'                        + Infrastructure adapters + Celery Tasks
'  Pydantic schemas (DTOs) shown in their own package.
'  Solid line  = Association (structural attribute reference)
'  Dashed line = Dependency  (uses via method param / local variable)
' =====================================================================

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

' =====================================================================
'  APPLICATION ENTRYPOINT
' =====================================================================
package "app" {
    class FastAPI <<framework>>

    class Settings <<config>> {
        +MONGODB_URL : str
        +MONGODB_DB : str
        +REDIS_URL : str
        +CELERY_BROKER_URL : str
        +CELERY_RESULT_BACKEND : str
        +JWT_SECRET : str
        +JWT_ALGORITHM : str
        +JWT_EXPIRATION_MINUTES : int
        +DOCUMENT_SEARCH_LIMIT : int
        +CLASSIFIER_DIR : str
        +OLLAMA_URL : str
        +OLLAMA_MODEL : str
        +LLM_API_KEY : str
        +HF_TOKEN : str
    }
}

' =====================================================================
'  API LAYER — Routers
' =====================================================================
package "app.api" {
    class APIRouter <<framework>>

    class APIRouterAuth {
        +login(form, service) : AuthToken
        +register(form, service, _admin) : UserPublic
    }

    class APIRouterProjects {
        +create_project(name, service, user) : Project
        +list_projects(service, user) : list<Project>
        +get_project(project_id, service, user) : Project
        +delete_project(project_id, service, user) : None
        +get_available_topics(project_id, service, user) : SearchTopics
        +download_classifier(project_id, classifier_id, service, user) : FileResponse
        +delete_classifier(project_id, classifier_id, service, user) : None
    }

    class APIRouterSearch {
        +search(query, service, project_service, user, project_id) : SearchResult
        +get_documents_by_ids(doc_ids, service, _user) : list<dict>
        +get_languages(service, _user) : list<str>
    }

    class APIRouterTopics {
        +generate_topics(body, service, project_service, user) : dict
        +reconcile_topics(body, service, project_service, user) : dict
    }

    class APIRouterClassification {
        +train_classifier(body, service, project_service, user) : dict
        +apply_initial_labels(body, project_service, user) : LabellingResult
        +label_documents(body, service, project_service, user) : dict
    }

    class APIRouterVisualisation {
        +load_dashboard(query, service, project_service, user, project_id) : Dashboard
    }

    class APIRouterJobs {
        +stream_job(job_id, job_queue, _user) : EventSourceResponse
    }

    class Dependencies <<module>> {
        +get_db() : AsyncIOMotorDatabase
        +get_user_repo(db) : UserRepository
        +get_document_repo(db) : DocumentRepository
        +get_project_repo(db) : ProjectRepository
        +get_topic_repo(db) : TopicRepository
        +get_auth_service(...) : AuthService
        +get_search_service(...) : SearchService
        +get_project_service(...) : ProjectService
        +get_visualisation_service(...) : VisualisationService
        +get_redis() : Redis
        +get_job_queue(redis) : JobQueueService
        +get_classification_service(...) : ClassificationService
        +get_topic_modelling_service(...) : TopicModellingService
        +get_current_user(...) : User
        +get_current_admin(...) : User
    }

    APIRouter <|-- APIRouterAuth
    APIRouter <|-- APIRouterProjects
    APIRouter <|-- APIRouterSearch
    APIRouter <|-- APIRouterTopics
    APIRouter <|-- APIRouterClassification
    APIRouter <|-- APIRouterVisualisation
    APIRouter <|-- APIRouterJobs
}

' =====================================================================
'  SERVICE LAYER
' =====================================================================
package "app.services" {
    class AuthService {
        -_user_repo : UserRepository
        -_hasher : PasswordHasher
        -_jwt : JWTHandler
        +login(username, password) : AuthToken
        +verify_token(token) : User
        +register_user(form) : User
    }

    class SearchService {
        -_document_repo : DocumentRepository
        +search(query, proxy_doc_ids) : SearchResult
        +get_documents_by_ids(doc_ids) : list<Document>
        +get_available_languages() : list<str>
        -_matched_subtopic_labels(doc, query) : list<str>
        -_to_summary(doc, query) : DocumentSummary
    }

    class ProjectService {
        -_project_repo : ProjectRepository
        -_topic_repo : TopicRepository
        +create_project(owner_id, name) : Project
        +get_project(project_id) : Project
        +list_projects(owner_id) : list<Project>
        +delete_project(project_id) : None
        +save_classifier(project_id, classifier) : None
        +get_classifier(project_id, classifier_id) : ClassifierMetadata
        +delete_classifier(project_id, classifier_id) : None
        +get_available_topics(project_id) : SearchTopics
        +verify_project_owner(project_id, user_id) : None
        +filter_proxies_by_subtopics(project_id, subtopics, threshold) : dict
        +get_proxy_confidence_by_topics(project_id, topics) : dict
        +upsert_document_proxies(project_id, proxies) : None
        +set_pending_pipeline(project_id, pipeline) : None
        +stamp_pipeline_classifier(project_id, classifier_id) : None
        +update_reconciled_topics(project_id, topics) : None
        +clear_pending_pipeline(project_id) : None
        +get_pending_pipeline(project_id) : PendingPipeline
        +get_labelled_doc_ids(project_id, classifier_id) : set<str>
        +apply_pipeline_labels(project_id, classifier_id) : LabellingResult
    }

    class ClassificationService {
        -_job_queue : JobQueueService
        +submit_training(topics, project_id, name) : str
        +submit_labelling(project_id, classifier_id, query) : str
    }

    class TopicModellingService {
        -_job_queue : JobQueueService
        +submit_generation(project_id, doc_ids) : str
        +submit_reconciliation(project_id, topics) : str
    }

    class VisualisationService {
        -_document_repo : DocumentRepository
        -_project_service : ProjectService
        +load_dashboard(query, project_id) : Dashboard
        -_resolve_proxy_confidence(topics, project_id) : dict
        -_apportion_slots(confidences, sample_size) : dict
        -_topic_evolution(query, proxy_doc_ids) : list<TopicTimeSeries>
        -_topics_by_language(query, proxy_doc_ids) : list<TopicLanguageBreakdown>
        -_topics_by_platform(query, proxy_doc_ids) : list<TopicPlatformBreakdown>
        -_top_entities(query, proxy_doc_ids) : list<TopicEntities>
        -_relevant_documents(query, proxy_confidence) : list<DocumentPreview>
    }

    class LLMClient {
        +reconcile(topics) : tuple<list<Topic>, bool>
    }

    class PageRank <<module>> {
        +top_entities(doc_entity_lists, limit) : list<tuple>
    }
}

' =====================================================================
'  REPOSITORY LAYER
' =====================================================================
package "app.repositories" {
    class UserRepository {
        -_collection : Collection
        +find_by_username(username) : User
        +save(user) : None
    }

    class DocumentRepository {
        -_collection : Collection
        +find(query, proxy_doc_ids) : list<dict>
        +find_by_ids(doc_ids) : list<dict>
        +count(query, proxy_doc_ids) : int
        +distinct_languages() : list<str>
        +get_excerpt(doc_id) : str
        +topic_presence_over_time(...) : list<dict>
        +topic_presence_by_language(...) : list<dict>
        +topic_presence_by_platform(...) : list<dict>
        +entities_for_topic(...) : list<list<str>>
        +relevant_documents(...) : list<dict>
        +mean_topic_confidence(topic, ...) : float
        -_build_filter(query, proxy_doc_ids) : dict
        -_build_vis_match(...) : dict
        -_relevance_stage(topic, proxy_confidence) : dict
        -_coerce_object_ids(doc_ids) : list<ObjectId>
    }

    class ProjectRepository {
        -_collection : Collection
        +save(project) : None
        +find_by_id(project_id) : Project
        +find_by_owner(owner_id) : list<Project>
        +delete(project_id) : None
        +add_classifier(project_id, classifier) : None
        +find_classifier(project_id, classifier_id) : ClassifierMetadata
        +find_all_classifiers(project_id) : list<ClassifierMetadata>
        +delete_classifier(project_id, classifier_id) : None
        +filter_proxy_doc_ids_by_subtopics(project_id, subtopics, threshold) : dict
        +find_proxy_confidence_by_topics(project_id, topics) : dict
        +set_pending_pipeline(project_id, pipeline) : None
        +stamp_pipeline_classifier(project_id, classifier_id) : None
        +update_reconciled_topics(project_id, topics) : None
        +clear_pending_pipeline(project_id) : None
        +find_pending_pipeline(project_id) : PendingPipeline
        +find_labelled_doc_ids(project_id, classifier_id) : set<str>
        +upsert_document_proxies(project_id, proxies) : None
    }

    class TopicRepository {
        -_collection : Collection
        +find_all() : list<Topic>
        +find_by_core_topic(core_topic) : list<Topic>
    }
}

' =====================================================================
'  INFRASTRUCTURE LAYER
' =====================================================================
package "app.infrastructure" {
    class JWTHandler {
        +encode(payload) : str
        +decode(token) : dict
    }

    class PasswordHasher {
        +hash(password) : str
        +verify(password, hashed) : bool
    }

    class ClassifierWrapper {
        -_model : FastText
        +train(texts, labels) : None
        +predict(text) : tuple<str, float>
        +save(path) : None
        +load(path) : None
    }

    class EmbeddingCache {
        +get(doc_ids) : ndarray
        +store(doc_ids, embeddings) : None
    }

    class MutexManager {
        -_redis : Redis
        -_default_ttl : int
        +acquire(key, ttl) : bool
        +release(key) : None
        +is_locked(key) : bool
    }

    class JobQueueService {
        -_celery : Celery
        -_redis : Redis
        +dispatch(task_name, kwargs) : str
        +get_status(job_id) : JobStatus
        +stream_progress(job_id) : AsyncGenerator<JobStatus>
    }

    class MongoDB <<module>> {
        +client : AsyncIOMotorClient
        +db : AsyncIOMotorDatabase
    }
}

' =====================================================================
'  CELERY TASK LAYER
' =====================================================================
package "app.tasks" {
    class CeleryApp <<module>> {
        +celery_app : Celery
    }

    class ClassifierTrainingTask <<celery_task>> {
        +classifier_training_task(topics, project_id, name) : dict
    }

    class LabellingTask <<celery_task>> {
        +labelling_task(project_id, classifier_id, query) : dict
    }

    class ReconciliationTask <<celery_task>> {
        +reconciliation_task(project_id, topics) : dict
    }

    class TopicGenerationTask <<celery_task>> {
        +topic_generation_task(project_id, doc_ids) : dict
    }

    class BaseRepresentation <<framework>>

    class OllamaRepresentation {
        -_labels : dict<int, tuple>
        -_task : Task
        -_topic_count_ref : list
        -_labelled : int
        +KEYWORD_LIMIT : int
        +extract_topics(model, documents, c_tf_idf, topics) : dict
    }

    class TaskContext <<module>> {
        +search_service_context() : SearchService
        +project_service_context() : ProjectService
        +mutex_manager_context() : MutexManager
    }

    BaseRepresentation <|-- OllamaRepresentation
}

' =====================================================================
'  SCHEMAS / DTOs (Pydantic BaseModel)
' =====================================================================
package "app.schemas" {
    ' ---- auth ----
    class User {
        +user_id : str
        +name : str
        +surname : str
        +username : str
        +hashed_password : str
        +role : str
    }
    class UserPublic {
        +user_id : str
        +name : str
        +surname : str
        +username : str
        +role : str
    }
    class AuthToken {
        +access_token : str
        +token_type : str
    }
    class LoginForm {
        +username : str
        +password : str
    }
    class RegistrationForm {
        +name : str
        +surname : str
        +username : str
        +password : str
        +role : str
    }

    ' ---- search ----
    class SearchQuery {
        +keywords : list<str>
        +date_from : datetime
        +date_to : datetime
        +languages : list<str>
        +platforms : list<str>
        +topics : list<str>
        +subtopics : list<str>
        +confidence_threshold : float
    }
    class DocumentSummary {
        +doc_id : str
        +headline : str
        +excerpt : str
        +platform : str
        +language : str
        +date : datetime
        +relevant_topics : list<str>
    }
    class SearchResult {
        +total_docs : int
    }
    class TopicChoice {
        +topic_id : str
        +name : str
        +core_topic : str
    }
    class SearchTopics {
        +core_topics : list<TopicChoice>
        +subtopics : list<TopicChoice>
    }

    ' ---- topic ----
    class Topic {
        +topic_id : str
        +name : str
        +description : str
        +origin_topic_ids : list<str>
        +core_topic : str
    }
    class GenerateTopicsRequest {
        +project_id : str
        +doc_ids : list<str>
    }
    class ReconciliationRequest {
        +project_id : str
    }
    class GenerateTopicsResponse {
        +llm_available : bool
    }
    class ReconciliationResponse {
        +llm_available : bool
    }

    ' ---- classification ----
    class TrainClassifierRequest {
        +project_id : str
        +name : str
    }
    class ClassifierMetadata {
        +classifier_id : str
        +name : str
        +file_path : str
        +created_at : datetime
    }
    class ProxyLabel {
        +topic_id : str
        +name : str
        +description : str
        +classifier_id : str
        +confidence : float
    }
    class DocumentProxy {
        +doc_id : str
    }
    class LabellingResult {
        +project_id : str
        +total_labelled : int
        +topic_summary : dict<str, int>
    }
    class LabelRequest {
        +project_id : str
        +classifier_id : str
    }
    class InitialLabelRequest {
        +project_id : str
        +classifier_id : str
    }

    ' ---- project ----
    class PendingPipeline {
        +generation_job_id : str
        +created_at : datetime
        +classifier_id : str
        +topic_mapping : dict<str, list<str>>
    }
    class Project {
        +project_id : str
        +owner_id : str
        +name : str
        +created_at : datetime
    }

    ' ---- jobs ----
    class JobStatus {
        +job_id : str
        +status : str
        +progress : int
        +result : dict
    }

    ' ---- visualisation ----
    class VisualisationQuery {
        +topics : list<str>
        +date_from : datetime
        +date_to : datetime
        +languages : list<str>
        +platforms : list<str>
        +sample_size : int
    }
    class EntityScore {
        +entity : str
        +score : float
    }
    class TopicEntities {
        +topic : str
    }
    class TimePoint {
        +date : str
        +count : int
    }
    class TopicTimeSeries {
        +topic : str
    }
    class LanguageCount {
        +language : str
        +count : int
    }
    class TopicLanguageBreakdown {
        +topic : str
    }
    class PlatformCount {
        +platform : str
        +count : int
    }
    class TopicPlatformBreakdown {
        +topic : str
    }
    class DocumentPreview {
        +doc_id : str
        +platform : str
        +language : str
        +date : datetime
        +topic : str
        +relevance_score : float
        +excerpt : str
    }
    class Dashboard
}

' =====================================================================
'  RELATIONSHIPS
' =====================================================================

' ---- entrypoint ----
FastAPI o-- APIRouterAuth
FastAPI o-- APIRouterProjects
FastAPI o-- APIRouterSearch
FastAPI o-- APIRouterTopics
FastAPI o-- APIRouterClassification
FastAPI o-- APIRouterVisualisation
FastAPI o-- APIRouterJobs

' ---- routers -> services (resolved via Dependencies) ----
APIRouterAuth ..> AuthService
APIRouterProjects ..> ProjectService
APIRouterSearch ..> SearchService
APIRouterSearch ..> ProjectService
APIRouterTopics ..> TopicModellingService
APIRouterTopics ..> ProjectService
APIRouterClassification ..> ClassificationService
APIRouterClassification ..> ProjectService
APIRouterVisualisation ..> VisualisationService
APIRouterVisualisation ..> ProjectService
APIRouterJobs ..> JobQueueService

' ---- routers -> schemas (request / response types) ----
APIRouterAuth ..> LoginForm
APIRouterAuth ..> RegistrationForm
APIRouterAuth ..> AuthToken
APIRouterAuth ..> UserPublic
APIRouterSearch ..> SearchQuery
APIRouterSearch ..> SearchResult
APIRouterTopics ..> GenerateTopicsRequest
APIRouterTopics ..> ReconciliationRequest
APIRouterTopics ..> GenerateTopicsResponse
APIRouterTopics ..> ReconciliationResponse
APIRouterClassification ..> TrainClassifierRequest
APIRouterClassification ..> LabelRequest
APIRouterClassification ..> InitialLabelRequest
APIRouterClassification ..> LabellingResult
APIRouterVisualisation ..> VisualisationQuery
APIRouterVisualisation ..> Dashboard
APIRouterProjects ..> Project
APIRouterProjects ..> SearchTopics
APIRouterJobs ..> JobStatus

' ---- Dependencies -> repositories + MongoDB (factory functions) ----
Dependencies ..> UserRepository
Dependencies ..> DocumentRepository
Dependencies ..> ProjectRepository
Dependencies ..> TopicRepository
Dependencies ..> MongoDB
Dependencies ..> AuthService
Dependencies ..> SearchService
Dependencies ..> ProjectService
Dependencies ..> VisualisationService
Dependencies ..> ClassificationService
Dependencies ..> TopicModellingService
Dependencies ..> JobQueueService

' ---- services -> repositories (solid: stored as attributes) ----
AuthService --> UserRepository
AuthService --> PasswordHasher
AuthService --> JWTHandler

SearchService --> DocumentRepository

ProjectService --> ProjectRepository
ProjectService --> TopicRepository

ClassificationService --> JobQueueService
TopicModellingService --> JobQueueService

VisualisationService --> DocumentRepository
VisualisationService --> ProjectService

' ---- services -> tasks (runtime dispatch by name via JobQueueService, NOT an import) ----
ClassificationService ..> ClassifierTrainingTask : «dispatches»
ClassificationService ..> LabellingTask : «dispatches»
TopicModellingService ..> TopicGenerationTask : «dispatches»
TopicModellingService ..> ReconciliationTask : «dispatches»

' ---- services -> PageRank module ----
VisualisationService ..> PageRank

' ---- services -> schemas (parameter / return / constructed types) ----
AuthService ..> AuthToken
AuthService ..> User
AuthService ..> RegistrationForm

SearchService ..> SearchQuery
SearchService ..> SearchResult
SearchService ..> DocumentSummary

ProjectService ..> Project
ProjectService ..> ClassifierMetadata
ProjectService ..> Topic
ProjectService ..> DocumentProxy
ProjectService ..> ProxyLabel
ProjectService ..> PendingPipeline
ProjectService ..> LabellingResult
ProjectService ..> SearchTopics

TopicModellingService ..> Topic

ClassificationService ..> Topic
ClassificationService ..> SearchQuery

LLMClient ..> Topic

VisualisationService ..> VisualisationQuery
VisualisationService ..> Dashboard
VisualisationService ..> TopicTimeSeries
VisualisationService ..> TimePoint
VisualisationService ..> TopicLanguageBreakdown
VisualisationService ..> LanguageCount
VisualisationService ..> TopicPlatformBreakdown
VisualisationService ..> PlatformCount
VisualisationService ..> TopicEntities
VisualisationService ..> EntityScore
VisualisationService ..> DocumentPreview

' ---- repositories -> MongoDB + schemas ----
UserRepository ..> User
UserRepository ..> MongoDB
DocumentRepository ..> SearchQuery
DocumentRepository ..> MongoDB
ProjectRepository ..> Project
ProjectRepository ..> ClassifierMetadata
ProjectRepository ..> DocumentProxy
ProjectRepository ..> PendingPipeline
ProjectRepository ..> MongoDB
TopicRepository ..> Topic
TopicRepository ..> MongoDB

' ---- infrastructure -> Settings ----
JWTHandler ..> Settings
MongoDB ..> Settings
JobQueueService ..> Settings
MutexManager ..> Settings
LLMClient ..> Settings
OllamaRepresentation ..> Settings
ClassifierWrapper ..> Settings
EmbeddingCache ..> Settings
DocumentRepository ..> Settings

' ---- infrastructure: JobQueueService -> CeleryApp ----
JobQueueService --> CeleryApp
JobQueueService ..> JobStatus

' ---- tasks -> CeleryApp (all tasks are registered with the Celery app) ----
ClassifierTrainingTask ..> CeleryApp
LabellingTask ..> CeleryApp
