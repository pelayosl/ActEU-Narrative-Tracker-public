@startuml classification_subsystem
' =====================================================================
'  Classification Subsystem
'  Covers: project management (CRUD), classifier training (FastText),
'  Phase 1 labelling (synchronous, from topic_mapping),
'  Phase 2 labelling (asynchronous, classifier inference on new queries),
'  and document proxy management within a project context.
' =====================================================================

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

skinparam class {
    BackgroundColor<<external>> #F0F0F0
    BorderColor<<external>>     #AAAAAA
    FontColor<<external>>       #666666
}

' =====================================================================
'  EXTERNAL DEPENDENCIES
' =====================================================================
package "External" {
    class ProjectRepository <<external>> {
        +save(project) : None
        +find_by_id(project_id) : Project
        +find_by_owner(owner_id) : list<Project>
        +delete(project_id) : None
        +add_classifier(project_id, classifier) : None
        +find_classifier(project_id, classifier_id) : ClassifierMetadata
        +delete_classifier(project_id, classifier_id) : None
        +upsert_document_proxies(project_id, proxies) : None
        +set_pending_pipeline(project_id, pipeline) : None
        +stamp_pipeline_classifier(project_id, classifier_id) : None
        +update_reconciled_topics(project_id, topics) : None
        +clear_pending_pipeline(project_id) : None
        +find_pending_pipeline(project_id) : PendingPipeline
        +find_labelled_doc_ids(project_id, classifier_id) : set<str>
        +filter_proxy_doc_ids_by_subtopics(project_id, subtopics, threshold) : dict
        +find_proxy_confidence_by_topics(project_id, topics) : dict
    }

    class TopicRepository <<external>> {
        +find_all() : list<Topic>
        +find_by_core_topic(core_topic) : list<Topic>
    }

    class SearchService <<external>> {
        +search(query, proxy_doc_ids) : SearchResult
        +get_documents_by_ids(doc_ids) : list<Document>
    }

    class JobQueueService <<external>> {
        +dispatch(task_name, kwargs) : str
    }

    class MutexManager <<external>> {
        +acquire(key, ttl) : bool
        +release(key) : None
        +is_locked(key) : bool
    }

    class Settings <<external>> {
        +CLASSIFIER_DIR : str
    }

    class CeleryApp <<external>> {
        +celery_app : Celery
    }

    class MongoDB <<external>> {
        +db : AsyncIOMotorDatabase
    }
}

' =====================================================================
'  INFRASTRUCTURE (adapter)
' =====================================================================
package "app.infrastructure" {
    class ClassifierWrapper {
        -_model : FastText
        +train(texts : list<str>, labels : list<str>) : None
        +predict(text : str) : tuple<str, float>
        +save(path : str) : None
        +load(path : str) : None
    }
}

' =====================================================================
'  SERVICES
' =====================================================================
package "app.services" {
    class ClassificationService {
        -_job_queue : JobQueueService
        +submit_training(topics : list<Topic>, project_id : str, name : str) : str
        +submit_labelling(project_id : str, classifier_id : str, query : SearchQuery) : str
    }

    class ProjectService {
        -_project_repo : ProjectRepository
        -_topic_repo : TopicRepository
        +create_project(owner_id : str, name : str) : Project
        +get_project(project_id : str) : Project
        +list_projects(owner_id : str) : list<Project>
        +delete_project(project_id : str) : None
        +save_classifier(project_id : str, classifier : ClassifierMetadata) : None
        +get_classifier(project_id : str, classifier_id : str) : ClassifierMetadata
        +delete_classifier(project_id : str, classifier_id : str) : None
        +get_available_topics(project_id : str) : SearchTopics
        +verify_project_owner(project_id : str, user_id : str) : None
        +filter_proxies_by_subtopics(project_id, subtopics, threshold) : dict
        +get_proxy_confidence_by_topics(project_id, topics) : dict
        +upsert_document_proxies(project_id : str, proxies : list) : None
        +set_pending_pipeline(project_id : str, pipeline : PendingPipeline) : None
        +stamp_pipeline_classifier(project_id : str, classifier_id : str) : None
        +update_reconciled_topics(project_id : str, topics : list) : None
        +clear_pending_pipeline(project_id : str) : None
        +get_pending_pipeline(project_id : str) : PendingPipeline
        +get_labelled_doc_ids(project_id : str, classifier_id : str) : set<str>
        +apply_pipeline_labels(project_id : str, classifier_id : str) : LabellingResult
    }
}

' =====================================================================
'  TASKS
' =====================================================================
package "app.tasks" {
    class TaskContext <<module>> {
        +search_service_context() : SearchService
        +project_service_context() : ProjectService
        +mutex_manager_context() : MutexManager
    }

    class ClassifierTrainingTask <<celery_task>> {
        +classifier_training_task(topics : list<Topic>, project_id : str, name : str) : dict
    }

    class LabellingTask <<celery_task>> {
        +labelling_task(project_id : str, classifier_id : str, query : SearchQuery) : dict
    }
}

' =====================================================================
'  SCHEMAS
' =====================================================================
package "app.schemas.classification" {
    class TrainClassifierRequest {
        +project_id : str
        +name : str
    }

    class LabelRequest {
        +project_id : str
        +classifier_id : str
    }

    class InitialLabelRequest {
        +project_id : str
        +classifier_id : str
    }

    class ClassifierMetadata {
        +classifier_id : str
        +name : str
        +file_path : str
        +created_at : datetime
    }

    class DocumentProxy {
        +doc_id : str
    }

    class ProxyLabel {
        +topic_id : str
        +name : str
        +description : str
        +classifier_id : str
        +confidence : float
    }

    class LabellingResult {
        +project_id : str
        +total_labelled : int
        +topic_summary : dict<str, int>
    }
}

package "app.schemas.project" {
    class Project {
        +project_id : str
        +owner_id : str
        +name : str
        +created_at : datetime
    }

    class PendingPipeline {
        +generation_job_id : str
        +topic_mapping : dict<str, list<str>>
        +created_at : datetime
        +classifier_id : str
    }
}

package "app.schemas.search (referenced)" {
    class SearchQuery <<schema>> {
        +keywords : list<str>
        +topics : list<str>
        +subtopics : list<str>
        +confidence_threshold : float
    }
    class SearchTopics <<schema>>
}

package "app.schemas.topic (referenced)" {
    class Topic <<schema>> {
        +topic_id : str
        +name : str
        +description : str
        +origin_topic_ids : list<str>
    }
}

' =====================================================================
'  RELATIONSHIPS
' =====================================================================

' --- structural (solid) ---
ClassificationService --> JobQueueService
ProjectService --> ProjectRepository
ProjectService --> TopicRepository
ClassifierWrapper ..> Settings

' --- services -> tasks (runtime dispatch by name via JobQueueService, NOT an import) ---
ClassificationService ..> ClassifierTrainingTask : «dispatches»
ClassificationService ..> LabellingTask : «dispatches»

' --- services -> schemas ---
ProjectService ..> Project
ProjectService ..> ClassifierMetadata
ProjectService ..> Topic
ProjectService ..> DocumentProxy
ProjectService ..> ProxyLabel
ProjectService ..> PendingPipeline
ProjectService ..> LabellingResult
ProjectService ..> SearchTopics

ClassificationService ..> Topic
ClassificationService ..> SearchQuery

' --- tasks -> TaskContext ---
ClassifierTrainingTask ..> TaskContext
LabellingTask ..> TaskContext

TaskContext ..> SearchService
TaskContext ..> ProjectService
TaskContext ..> MutexManager
TaskContext ..> MongoDB

' --- tasks -> services (direct runtime dependencies) ---
ClassifierTrainingTask ..> SearchService
ClassifierTrainingTask ..> ProjectService
LabellingTask ..> SearchService
LabellingTask ..> ProjectService
LabellingTask ..> MutexManager

' --- tasks -> infrastructure ---
ClassifierTrainingTask ..> ClassifierWrapper
ClassifierTrainingTask ..> ClassifierMetadata
ClassifierTrainingTask ..> CeleryApp
LabellingTask ..> ClassifierWrapper
LabellingTask ..> DocumentProxy
LabellingTask ..> CeleryApp

' --- schema composition ---
Project *-- "0..*" ClassifierMetadata
Project *-- "0..*" DocumentProxy
Project *-- "0..1" PendingPipeline
ClassifierMetadata *-- "0..*" Topic
DocumentProxy *-- "0..*" ProxyLabel
PendingPipeline *-- "0..*" Topic
TrainClassifierRequest *-- "0..*" Topic
LabelRequest *-- SearchQuery

@enduml
