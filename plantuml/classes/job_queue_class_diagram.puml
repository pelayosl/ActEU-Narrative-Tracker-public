@startuml job_queue_subsystem
' =====================================================================
'  Job Queue Subsystem
'  Covers: asynchronous Celery task dispatch, Redis-backed job status
'  tracking, SSE progress streaming, and per-project mutex locking
'  to prevent concurrent write races on document proxies.
' =====================================================================

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

skinparam class {
    BackgroundColor<<external>> #F0F0F0
    BorderColor<<external>>     #AAAAAA
    FontColor<<external>>       #666666
}

' =====================================================================
'  EXTERNAL DEPENDENCIES
' =====================================================================
package "External" {
    class Settings <<external>> {
        +REDIS_URL : str
        +CELERY_BROKER_URL : str
        +CELERY_RESULT_BACKEND : str
    }
}

' =====================================================================
'  INFRASTRUCTURE
' =====================================================================
package "app.infrastructure" {
    class CeleryApp <<module>> {
        +celery_app : Celery
    }

    class JobQueueService {
        -_celery : Celery
        -_redis : Redis
        +dispatch(task_name : str, kwargs : dict) : str
        +get_status(job_id : str) : JobStatus
        +stream_progress(job_id : str) : AsyncGenerator<JobStatus>
    }

    class MutexManager {
        -_redis : Redis
        -_default_ttl : int
        +acquire(key : str, ttl : int) : bool
        +release(key : str) : None
        +is_locked(key : str) : bool
    }
}

' =====================================================================
'  SCHEMAS
' =====================================================================
package "app.schemas.jobs" {
    class JobStatus {
        +job_id : str
        +status : str
        +progress : int
        +result : dict
    }
}

' =====================================================================
'  RELATIONSHIPS
' =====================================================================

' --- structural (solid) ---
JobQueueService --> CeleryApp

' --- infrastructure -> settings ---
JobQueueService ..> Settings
MutexManager ..> Settings

' --- infrastructure -> schemas ---
JobQueueService ..> JobStatus

@enduml
