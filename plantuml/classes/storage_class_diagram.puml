@startuml storage_subsystem
' =====================================================================
'  Storage Subsystem
'  Covers: all four MongoDB repositories and the shared database
'  connection module. This subsystem encapsulates every read and write
'  operation against the database; no layer above constructs a query.
' =====================================================================

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

skinparam class {
    BackgroundColor<<external>> #F0F0F0
    BorderColor<<external>>     #AAAAAA
    FontColor<<external>>       #666666
}

' =====================================================================
'  EXTERNAL DEPENDENCIES
' =====================================================================
package "External" {
    class Settings <<external>> {
        +MONGODB_URL : str
        +MONGODB_DB : str
        +DOCUMENT_SEARCH_LIMIT : int
    }
}

' =====================================================================
'  INFRASTRUCTURE — shared database connection
' =====================================================================
package "app.infrastructure" {
    class MongoDB <<module>> {
        +client : AsyncIOMotorClient
        +db : AsyncIOMotorDatabase
    }
}

' =====================================================================
'  REPOSITORIES
' =====================================================================
package "app.repositories" {

    class UserRepository {
        -_collection : Collection
        +find_by_username(username : str) : User
        +save(user : User) : None
    }

    class DocumentRepository {
        -_collection : Collection
        +find(query : SearchQuery, proxy_doc_ids : list) : list<dict>
        +find_by_ids(doc_ids : list<str>) : list<dict>
        +count(query : SearchQuery, proxy_doc_ids : list) : int
        +distinct_languages() : list<str>
        +get_excerpt(doc_id : str) : str
        +topic_presence_over_time(topic, date_from, date_to, languages, platforms, proxy_doc_ids) : list<dict>
        +topic_presence_by_language(topic, date_from, date_to, languages, platforms, proxy_doc_ids) : list<dict>
        +topic_presence_by_platform(topic, date_from, date_to, languages, platforms, proxy_doc_ids) : list<dict>
        +entities_for_topic(topic, date_from, date_to, languages, platforms, proxy_doc_ids) : list<list<str>>
        +relevant_documents(topic, date_from, date_to, languages, platforms, proxy_confidence, limit) : list<dict>
        +mean_topic_confidence(topic, date_from, date_to, languages, platforms, proxy_confidence) : float
        -_build_filter(query : SearchQuery, proxy_doc_ids : list) : dict
        -_build_vis_match(topic, date_from, date_to, languages, platforms, proxy_doc_ids) : dict
        -_relevance_stage(topic : str, proxy_confidence : dict) : dict
        -_coerce_object_ids(doc_ids : list<str>) : list<ObjectId>
    }

    class ProjectRepository {
        -_collection : Collection
        +save(project : Project) : None
        +find_by_id(project_id : str) : Project
        +find_by_owner(owner_id : str) : list<Project>
        +delete(project_id : str) : None
        +add_classifier(project_id : str, classifier : ClassifierMetadata) : None
        +find_classifier(project_id : str, classifier_id : str) : ClassifierMetadata
        +find_all_classifiers(project_id : str) : list<ClassifierMetadata>
        +delete_classifier(project_id : str, classifier_id : str) : None
        +filter_proxy_doc_ids_by_subtopics(project_id, subtopics, threshold) : dict
        +find_proxy_confidence_by_topics(project_id : str, topics : list) : dict
        +set_pending_pipeline(project_id : str, pipeline : PendingPipeline) : None
        +stamp_pipeline_classifier(project_id : str, classifier_id : str) : None
        +update_reconciled_topics(project_id : str, topics : list) : None
        +clear_pending_pipeline(project_id : str) : None
        +find_pending_pipeline(project_id : str) : PendingPipeline
        +find_labelled_doc_ids(project_id : str, classifier_id : str) : set<str>
        +upsert_document_proxies(project_id : str, proxies : list) : None
    }

    class TopicRepository {
        -_collection : Collection
        +find_all() : list<Topic>
        +find_by_core_topic(core_topic : str) : list<Topic>
    }
}

' =====================================================================
'  SCHEMAS (return / parameter types shown for clarity)
' =====================================================================
package "app.schemas (referenced)" {
    class User <<schema>>
    class SearchQuery <<schema>>
    class Topic <<schema>>
    class Project <<schema>>
    class ClassifierMetadata <<schema>>
    class DocumentProxy <<schema>>
    class PendingPipeline <<schema>>
}

' =====================================================================
'  RELATIONSHIPS
' =====================================================================

' --- infrastructure ---
MongoDB ..> Settings

' --- repositories -> MongoDB ---
UserRepository ..> MongoDB
DocumentRepository ..> MongoDB
ProjectRepository ..> MongoDB
TopicRepository ..> MongoDB

' --- repositories -> Settings ---
DocumentRepository ..> Settings

' --- repositories -> schemas ---
UserRepository ..> User
DocumentRepository ..> SearchQuery
TopicRepository ..> Topic
ProjectRepository ..> Project
ProjectRepository ..> ClassifierMetadata
ProjectRepository ..> DocumentProxy
ProjectRepository ..> PendingPipeline

@enduml
