@startuml
actor "User" as User
participant ":Pipeline\n(Frontend)" as UI
participant ":PipelineStore\n(Zustand)" as Store
participant ":API Gateway\n(/classification)" as API
participant ":ProjectService" as PS
participant ":ProjectRepository" as PR

autonumber

== Preconditions ==
note over User, UI
  User is authenticated, a project is active, and a classifier was
  just trained this session. pending_pipeline.topic_mapping still
  holds the topic assignment for the originally retrieved documents.
end note

== Main Flow ==

User -> UI : Click "Label Retrieved Documents"
UI -> Store : Read project_id + trained classifier_id
Store --> UI : project_id, classifier_id

UI -> API : POST /classification/label/initial\n{ project_id, classifier_id }
API -> API : get_current_user (verify bearer token)
API -> PS : verify_project_owner(project_id, user_id)
API -> PS : apply_pipeline_labels(project_id, classifier_id)

alt success (pipeline present, classifier found, pipeline.classifier_id == classifier_id)
    PS -> PS : For each classifier topic: union doc_ids from\norigin_topic_ids (or own id); build ProxyLabel\n(confidence = 1); accumulate topic_summary
    PS -> PR : upsert_document_proxies(project_id, proxies)
    PR --> PS : OK
    PS -> PR : clear_pending_pipeline(project_id)
    PR --> PS : OK
    PS --> API : LabellingResult { project_id, total_labelled, topic_summary }
    API --> UI : 200 OK — LabellingResult
    UI -> Store : setPhase1Result(result)
    UI --> User : Display labelling summary (topic + count)\nUnlock "Label Custom Query" (Phase 2) + "Go to Visualiser"

else pending_pipeline is None
    PS --> API : raise NoPendingPipeline
    API --> UI : 409 Conflict
    UI --> User : Notify: initial labelling unavailable

else classifier not in project
    PS --> API : raise ClassifierNotFound
    API --> UI : 404 Not Found

else pipeline.classifier_id != classifier_id (overwritten / not stamped)
    note right of PS : Overwritten by a newer pipeline run, or training hasn't\nstamped this classifier yet. pending_pipeline NOT cleared.
    PS --> API : raise PendingPipelineMismatch
    API --> UI : 409 Conflict
    UI --> User : Notify: use a custom query (Phase 2) instead.
end
@enduml
